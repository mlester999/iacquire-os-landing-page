# Public marketing origin used for canonical URLs and the signed backend Origin header.
NEXT_PUBLIC_SITE_URL=https://iacquire-os.vercel.app

# The existing application origin is https://www.iacquire.online. This is used only
# for a non-transactional link to the application; verification links are created
# and emailed by the application backend.
NEXT_PUBLIC_APP_ORIGIN=https://www.iacquire.online

# Existing application endpoint on iAcquireOS's canonical www origin.
IACQUIREOS_DEMO_REGISTER_URL=https://www.iacquire.online/api/public/demo/register

# Server-only HMAC signing secret shared with the iAcquireOS application as
# DEMO_REGISTRATION_SIGNING_SECRET. Generate at least 32 random bytes and keep
# the value out of NEXT_PUBLIC_* variables, source control, and browser code.
IACQUIREOS_BACKEND_SIGNING_SECRET=

# `backend` is the default. `mock` may be used only in local development and
# explicitly reports that no email was sent.
DEMO_REGISTRATION_MODE=backend

# Best-effort landing-server throttle. The application must also enforce
# distributed rate limits using trusted edge/client identity.
DEMO_RATE_LIMIT_MAX=5
DEMO_RATE_LIMIT_WINDOW_MS=60000
# One network-only retry; keep the full two-call budget within the route's 30 seconds.
DEMO_REGISTRATION_TIMEOUT_MS=13000
