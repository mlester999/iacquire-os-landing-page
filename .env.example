# Public marketing domain; leave blank until the production marketing URL is chosen.
NEXT_PUBLIC_SITE_URL=

# The existing application origin is https://iacquire.online. This is used only
# for a non-transactional link to the application; verification links are created
# and emailed by the application backend.
NEXT_PUBLIC_APP_ORIGIN=https://iacquire.online

# Exact existing iAcquireOS registration endpoint, supplied by the app team.
# Do not point this at a database or email provider.
IACQUIREOS_DEMO_REGISTER_URL=

# Server-only HMAC signing secret shared with the iAcquireOS application.
# Generate a unique secret with at least 32 random bytes before deployment.
IACQUIREOS_BACKEND_SIGNING_SECRET=

# `backend` is the default. `mock` may be used only in local development and
# explicitly reports that no email was sent.
DEMO_REGISTRATION_MODE=backend

# Best-effort landing-server throttle. The application must also enforce
# distributed rate limits using trusted edge/client identity.
DEMO_RATE_LIMIT_MAX=5
DEMO_RATE_LIMIT_WINDOW_MS=60000
DEMO_REGISTRATION_TIMEOUT_MS=8000
